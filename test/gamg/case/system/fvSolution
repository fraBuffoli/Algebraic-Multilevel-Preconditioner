FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Solver variants, selected with bubblyPressureFoam -solver <name>. Every solve starts from p = 0;
// the stopping test of OpenFOAM is then sum|b - A x| / sum|b| <= relTol (normalised L1 residual).
// relTol 1e-9: the true 2-norm residual ||b - A x||_2 / ||b||_2 is then ~1e-8, the tolerance of
// schwarz2lvl (with relTol 1e-8 GAMG stopped at up to 1.2e-7 in the 2-norm on the bubbles cases).
// GAMG defaults of OpenFOAM-10: nPreSweeps 0, nPostSweeps 2, nFinestSweeps 2, mergeLevels 1,
// nCellsInCoarsestLevel 10 (per process), agglomeration cached (fixed mesh), coarsest level solved
// iteratively.
solvers
{
    GAMG_GS     // the usual choice for p / p_rgh
    {
        solver          GAMG;
        smoother        GaussSeidel;
        agglomerator    faceAreaPair;   // default: pairs cells by face area (geometry only)
        tolerance       0;
        relTol          1e-9;
        maxIter         1000;
    }

    GAMG_DIC
    {
        $GAMG_GS;
        smoother        DIC;
    }

    GAMG_ALG    // pairs cells by matrix coefficients: the agglomeration sees the density jumps
    {
        $GAMG_GS;
        agglomerator    algebraicPair;
    }

    PCG_GAMG    // GAMG V-cycles as preconditioner of CG
    {
        solver          PCG;
        preconditioner
        {
            preconditioner  GAMG;
            smoother        DICGaussSeidel;
            agglomerator    faceAreaPair;
            nVcycles        2;
            tolerance       0;
            relTol          0;
        }
        tolerance       0;
        relTol          1e-9;
        maxIter         1000;
    }

    PCG_DIC     // incomplete Cholesky (local to each process) + CG: single-level reference
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       0;
        relTol          1e-9;
        maxIter         5000;
    }

    // Warm-start campaign (Allrun_warm.sh): the p_rgh / p_rghFinal controls of a VoF solver
    // (interFoam tutorials). Every corrector stops at relTol 0.05 or at the absolute tolerance 1e-7
    // of the normalised residual, whichever comes first; the last corrector of every step uses the
    // dictionary <name>Final (bubblyPressureFoam), with relTol 0: tolerance 1e-7 only. Every solve
    // starts from the previous solution (bubblyPressureFoam -warmStart). Allrun_warm.sh replaces
    // the values 1e-7 and 0.05 below with ATOL and RTOL.
    W_GAMG          // GAMG with the DIC smoother (fastest variant of the earlier campaigns)
    {
        solver          GAMG;
        smoother        DIC;
        agglomerator    faceAreaPair;
        tolerance       1e-7;
        relTol          0.05;
        maxIter         1000;
    }

    W_GAMGFinal
    {
        $W_GAMG;
        relTol          0;
    }

    W_GAMG_PCG      // GAMG for the correctors, PCG + GAMG (2 V-cycles) for the last one
    {
        $W_GAMG;
    }

    W_GAMG_PCGFinal
    {
        solver          PCG;
        preconditioner
        {
            preconditioner  GAMG;
            smoother        DICGaussSeidel;
            agglomerator    faceAreaPair;
            nVcycles        2;
            tolerance       0;
            relTol          0;
        }
        tolerance       1e-7;
        relTol          0;
        maxIter         1000;
    }

    W_PCG_DIC       // PCG + DIC, the setting of the damBreak tutorial (single level)
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-7;
        relTol          0.05;
        maxIter         5000;
    }

    W_PCG_DICFinal
    {
        $W_PCG_DIC;
        relTol          0;
    }

    p
    {
        $GAMG_GS;
    }
}

