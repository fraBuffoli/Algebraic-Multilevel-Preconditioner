FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     bubblyPressureFoam;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         1;
deltaT          1;

writeControl    timeStep;
writeInterval   1;
purgeWrite      0;
writeFormat     binary;     // mesh written by blockMesh / decomposePar: fast to read
writePrecision  12;
writeCompression off;
timeFormat      general;
timePrecision   6;

runTimeModifiable false;

// ************************************************************************* //
